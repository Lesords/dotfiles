#!/usr/bin/env bash
# agent-rofi — desktop agent picker: list agents (@pane_* from
# tmux-agent-sidebar), Enter jumps to the agent: prefer a surface already
# attached to its session (raise that), else retune the one you're looking at.
#   agent-rofi --dry-run  print rows + jump targets, no rofi
set -u
# AGENT_ROFI_DEBUG=1 → xtrace to /tmp/agent-rofi-debug.log
[ "${AGENT_ROFI_DEBUG:-}" = 1 ] && { exec 2>/tmp/agent-rofi-debug.log; set -x; }

# Live agent ttys (one ps sweep) — ground truth for the stale gate.
declare -A agent_tty=()
while IFS= read -r t; do agent_tty["$t"]=1; done < <(
  ps -Ao tty=,comm= 2>/dev/null |
  awk '$1 ~ /^pts\// && $2 ~ /^(claude|opencode|codex)/ {print $1}')

# One call pulls everything. | separates (the sidebar scrubs it from
# @pane_* values); window/session names go last to absorb their own |.
stale=()
mapfile -t rows < <(tmux list-panes -a -F \
  '#{pane_id}|#{@pane_agent}|#{@pane_status}|#{@pane_session_id}|#{@pane_cwd}|#{@pane_prompt}|#{@pane_started_at}|#{@pane_notification_run_id}|#{pane_tty}|#{pane_current_command}|#{window_name}|#{session_name}' 2>/dev/null |
  awk -F'|' '$2 != ""')

now=$(date +%s)
ranked=()   # "rank<TAB>age_min<TAB>line<TAB>pane<TAB>agent<TAB>status<TAB>win<TAB>sess"
for r in "${rows[@]}"; do
  IFS='|' read -r pane agent status sid cwd prompt started notif tty cmd win sess <<<"$r"

  # Stale: agent gone, pane back at a shell. Drop the row; healed below.
  if [ -z "${agent_tty[${tty#/dev/}]:-}" ] &&
     [[ $cmd == bash || $cmd == zsh || $cmd == sh || $cmd == dash || $cmd == fish ]]; then
    stale+=("$pane"); continue
  fi

  # VS16 pins ⏳/⚡ to 2-cell emoji presentation so the dot can't shift
  # columns by status (printf escapes keep the selector visible)
  case $status in
    waiting)    dot=$(printf '<span foreground="#E06C75">⏳️</span>'); rank=0 ;;
    running)    dot=$(printf '<span foreground="#E5C07B">⚡️</span>'); rank=1 ;;
    background) dot='<span foreground="#5C6370">🌙</span>'; rank=2 ;;
    idle)       dot='<span foreground="#98C379">💤</span>'; rank=3 ;;
    *)          dot=$(printf '<span foreground="#5C6370">?️</span>'); rank=2 ;;
  esac

  # Age since the last event: newer of @pane_started_at (mid-turn) and
  # @pane_notification_run_id (epoch ms); "-" when neither
  ts=0
  [[ $started =~ ^[0-9]+$ ]] && ts=$started
  [[ $notif =~ ^[0-9]+$ ]] && (( notif / 1000 > ts )) && ts=$(( notif / 1000 ))
  if (( ts > 0 )); then
    s=$(( now - ts )); (( s < 0 )) && s=0
    mins=$(( s / 60 ))
    if   (( s < 60 ));   then age="${s}s"
    elif (( s < 3600 )); then age="$((s/60))m"
    else                      age="$((s/3600))h"
    fi
  else
    mins=99999; age="-"
  fi

  # name ← session title (custom > AI) from the jsonl tail, located directly
  # by @pane_session_id; fallbacks: sessions .name → cwd → window name
  name=""
  if [ -n "$sid" ]; then
    jsonl=$(compgen -G "$HOME/.claude/projects/*/$sid.jsonl" 2>/dev/null | head -1)
    [ -n "$jsonl" ] && name=$(tail -c 65536 "$jsonl" 2>/dev/null | awk '
      /"type":"custom-title"/ { if (match($0, /"customTitle":"[^"]*"/)) c = substr($0, RSTART + 15, RLENGTH - 16) }
      /"type":"ai-title"/     { if (match($0, /"aiTitle":"[^"]*"/))     a = substr($0, RSTART + 11, RLENGTH - 12) }
      END { print (c != "" ? c : a) }')
    [ -z "$name" ] &&
      name=$(jq -r --arg s "$sid" 'select(.sessionId == $s) | .name' \
        "$HOME"/.claude/sessions/*.json 2>/dev/null | head -1)
  fi
  [ -z "$name" ] && [ -n "$cwd" ] && name=${cwd##*/}
  [ -z "$name" ] && name=$win

  read -r prompt <<<"$prompt"                 # first line, trimmed
  # keep tabs out of the sort record; markup escaping happens in the
  # assembler awk below, after display widths are counted on raw text
  name=${name//$'\t'/ } ; prompt=${prompt//$'\t'/ }
  [ -z "$name" ] && name="?"

  ranked+=("${rank}"$'\t'"${mins}"$'\t'"$name"$'\t'"$prompt"$'\t'"$age"$'\t'"$dot"$'\t'"$pane"$'\t'"$agent"$'\t'"$status"$'\t'"$win"$'\t'"$sess")
done

# Self-heal: unset the lingering options so phantom rows stay gone
for sp in "${stale[@]}"; do
  for opt in @pane_agent @pane_status @pane_session_id @pane_cwd @pane_prompt \
             @pane_started_at @pane_wait_reason @pane_notification_run_id; do
    tmux set-option -t "$sp" -p -u "$opt" 2>/dev/null
  done
done

[ ${#ranked[@]} -eq 0 ] && { command -v notify-send >/dev/null && notify-send -u low "agent-rofi" "no agents running"; exit 0; }

# waiting first, idle last; newest event first within a rank
mapfile -t sorted < <(printf '%s\n' "${ranked[@]}" | sort -t$'\t' -k1,1n -k2,2n)

# Assemble markup rows, padding name/prompt to the run's max display width
# (CJK/emoji = 2 cells; gawk) so columns align — needs a dual-width mono
# theme font. Escaping happens here, after widths are counted on raw text.
# The width class includes East Asian Ambiguous glyphs (–…→①°±…) — the
# Noto CJK theme font renders those 2 cells wide, and a truncation "…"
# drifting one cell was exactly the misalignment that class caused.
rows=()
mapfile -t display < <(printf '%s\n' "${sorted[@]}" | awk -F'\t' '
  BEGIN { vs16 = sprintf("%c", 0xFE0F); zwj = sprintf("%c", 0x200D) }
  # cells per char: VS16/ZWJ joiners render zero-width; CJK/fullwidth/emoji
  # and the East-Asian-Ambiguous set render 2 in the Noto CJK theme font —
  # class verified against the hmtx table of that very font. Exceptions
  # counted as 1, their real advance: – (U+2013, 1.07) and ° (U+00B0,
  # 0.74); — (U+2014, 1.79) stays 2 as the closest integer.
  function dwc(c) {
    if (c == vs16 || c == zwj) return 0
    return (c ~ /[　-〿ぁ-ヿ一-鿿㐀-䶿가-힣豈-﫻！-｠🌀-🧿—-…←-↙①-⒇±§×÷·‰✅❌❓❔❗⭐✨⚡⏰⏳➕➖⛔⚪⚫☕✊✋☔⛄]/) ? 2 : 1
  }
  function dw(s,  i, n, w) {
    n = length(s); w = 0
    for (i = 1; i <= n; i++) w += dwc(substr(s, i, 1))
    return w
  }
  # truncate to a display-width budget, ellipsis (2 cells) included
  function dcut(s, maxw,   i, n, c, out, w) {
    if (dw(s) <= maxw) return s
    out = ""; w = 0; n = length(s); maxw -= 2
    for (i = 1; i <= n; i++) { c = substr(s, i, 1); if (w + dwc(c) > maxw) break; out = out c; w += dwc(c) }
    return out "…"
  }
  # strip glyphs the theme font lacks: fallback-font emoji render ~3.5 cells
  # wide against the 2 counted (+12px each, drifting their row) — a picker
  # row does not need them, and the status dots are built separately
  function nofb(s) {
    gsub(/[🀀-🫿☀-➿⬀-⯿️‍]/, "", s)
    return s
  }
  function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); return s }
  { nm[NR] = dcut(nofb($3), 30); pr[NR] = dcut(nofb($4), 60); age[NR]=$5; dot[NR]=$6; agt[NR]=$8
    nw[NR] = dw(nm[NR]); pw[NR] = dw(pr[NR])
    if (nw[NR] > nmx) nmx = nw[NR]
    if (pw[NR] > pmx) pmx = pw[NR] }
  END {
    if (nmx > 30) nmx = 30; if (nmx < 8) nmx = 8      # name column: 8..30 cells
    for (i = 1; i <= NR; i++) {
      line = dot[i] "  " esc(agt[i]) " · " esc(nm[i]) sprintf("%*s", nmx - nw[i], "")
      # prompt span always emitted (an empty prompt keeps the column width)
      # so the trailing age starts at one fixed x. Same size as the base
      # font on purpose: size="smaller" scales by 1/1.2 and puts column
      # edges on fractional pixels — one grid, exact integer cells.
      line = line "   <span foreground=\"#5C6370\">" esc(pr[i]) sprintf("%*s", pmx - pw[i], "") "</span>"
      print line "   <span foreground=\"#5C6370\">" age[i] "</span>"
    }
  }')
for rec in "${sorted[@]}"; do
  IFS=$'\t' read -r _ _ _ _ _ _ pane agent status win sess <<<"$rec"
  rows+=("$pane|$agent|$status|$win|$sess")
done

if [ "${1:-}" = "--dry-run" ]; then
  for i in "${!rows[@]}"; do
    IFS='|' read -r pane agent status win sess <<<"${rows[i]}"
    printf '%s   -> jump session=%s pane=%s\n' "${display[i]}" "$sess" "$pane"
  done
  exit 0
fi

# agents.rasi → mine.rasi for the desktop look; plain default if it's gone
targs=(-normal-window)
[ -f "$HOME/.config/rofi/agents.rasi" ] && targs+=(-theme "$HOME/.config/rofi/agents.rasi")
idx=$(printf '%s\n' "${display[@]}" |
  rofi -dmenu -i -markup-rows -format i -p agents "${targs[@]}" 2>/dev/null)
[ -z "$idx" ] && exit 0    # Esc / no selection
[[ $idx =~ ^[0-9]+$ ]] && (( idx < ${#rows[@]} )) || exit 0   # -format i is 0-based
sleep 0.15   # let i3 hand focus back after rofi closes, or it yanks it later

IFS='|' read -r pane agent status win sess <<<"${rows[idx]}"

jump() { tmux switch-client -c "$1" -t "$sess" \; select-window -t "$pane" \; select-pane -t "$pane"; }
# exact-id focus only — bare class focus marches i3 through every match
raise() { [ -n "$1" ] && i3-msg "[id=$1] focus" >/dev/null 2>&1; }
wxid()  { i3-msg -t get_tree 2>/dev/null |
  jq -r '.. | select(.window_properties?.class? == "org.wezfurlong.wezterm") | .window' | head -1; }
# wezterm's window that currently holds its GUI focus (X-focus driven)
fwid_of() {
  local pf
  pf=$(wezterm cli --no-auto-start list-clients --format json 2>/dev/null |
    jq -r '.[0].focused_pane_id // empty')
  printf '%s' "$wjson" |
    jq -r --argjson p "${pf:-0}" '.[] | select(.pane_id == $p) | .window_id // empty' 2>/dev/null | head -1
}
# internal window_id → X id: both id spaces are creation-ordered and paired
# 1:1 for the process lifetime, so a sorted zip maps them exactly. Counts
# disagree (stray same-class window / 2nd GUI instance) → empty, caller probes.
wxmap() {
  local a b
  a=$(printf '%s' "$wjson" | jq -r '[.[].window_id] | unique | .[]' 2>/dev/null)
  b=$(i3-msg -t get_tree 2>/dev/null |
    jq -r '[.. | objects | select(.window_properties?.class? == "org.wezfurlong.wezterm") | .window] | sort | .[]')
  [ "$(printf '%s\n' "$a" | grep -c .)" = "$(printf '%s\n' "$b" | grep -c .)" ] || return 1
  paste <(printf '%s\n' "$a") <(printf '%s\n' "$b") | awk -v w="$1" '$1 == w {print $2; exit}'
}

# ancestor pid whose comm matches the anchored regex $2, walking /proc
# PPid links (tmux comms contain spaces, so /proc/stat field arithmetic is
# off-limits). Regex, not a literal: konsole may live under an alias —
# Debian's x-terminal-emulator truncates its comm to "x-terminal-emul".
anc_pid() {
  local cur=$1 c
  while [ -n "$cur" ] && [ "$cur" != 1 ] && [ "$cur" != 0 ]; do
    read -r c < /proc/$cur/comm 2>/dev/null && [[ "$c" =~ ^$2$ ]] && { echo "$cur"; return 0; }
    cur=$(awk '/^PPid:/{print $2}' /proc/$cur/status 2>/dev/null)
  done
  return 1
}

# konsole driver — the one non-wezterm surface driven end to end: DBus maps
# each tab to its foreground pid (→ tty) and switches tabs; _NET_WM_PID maps
# the process to its X window. Quirk: setCurrentSession only takes effect
# while the window is focused — always raise first, switch after.
konsole_xid() {  # konsole pid → X id of its window ("" when none found)
  local x
  for x in $(i3-msg -t get_tree 2>/dev/null |
    jq -r '.. | objects | select((.window_properties?.class? // "") == "konsole") | .window'); do
    [ "$(xprop -id "$x" _NET_WM_PID 2>/dev/null | grep -o '[0-9]*$')" = "$1" ] && { echo "$x"; return 0; }
  done
  return 1
}
konsole_ftty() {  # X id → tty of the ACTIVE tab's foreground process
  command -v qdbus >/dev/null 2>&1 || return 1
  local pid svc w cs fg
  pid=$(xprop -id "$1" _NET_WM_PID 2>/dev/null | grep -o '[0-9]*$')
  [ -n "$pid" ] && qdbus org.kde.konsole-$pid >/dev/null 2>&1 || return 1
  svc=org.kde.konsole-$pid
  for w in $(qdbus "$svc" 2>/dev/null | awk '/^\/Windows\//{print}'); do
    cs=$(qdbus "$svc" "$w" currentSession 2>/dev/null) || continue
    fg=$(qdbus "$svc" "/Sessions/$cs" foregroundProcessId 2>/dev/null)
    if [ -n "$fg" ] && [ "$fg" != 0 ]; then
      ps -o tty= -p "$fg" 2>/dev/null | tr -d ' ' | sed 's|^|/dev/|'; return 0
    fi
  done
  return 1
}
konsole_surface() {  # raise the konsole window running tmux client tty $1,
  # then switch to that client's tab. setCurrentSession silently no-ops
  # until the window is truly focused and the raise is asynchronous — so
  # verify the switch took and retry instead of racing it.
  command -v qdbus >/dev/null 2>&1 || return 1
  local cp kpid svc w sid fg x i
  cp=$(tmux list-clients -F '#{client_name} #{client_pid}' 2>/dev/null |
    awk -v t="$1" '$1 == t {print $2; exit}')
  [ -n "$cp" ] || return 1
  kpid=$(anc_pid "$cp" 'konsole|x-terminal-emul') || return 1
  svc=org.kde.konsole-$kpid
  qdbus "$svc" >/dev/null 2>&1 || return 1
  for w in $(qdbus "$svc" 2>/dev/null | awk '/^\/Windows\//{print}'); do
    for sid in $(qdbus "$svc" "$w" sessionList 2>/dev/null | tr -d '(),'); do
      fg=$(qdbus "$svc" "/Sessions/$sid" foregroundProcessId 2>/dev/null)
      [ "$fg" = "$cp" ] || continue
      x=$(konsole_xid "$kpid") && raise "$x"
      for i in 1 2 3; do
        sleep 0.15   # let the X focus land before asking for a tab switch
        qdbus "$svc" "$w" setCurrentSession "$sid" >/dev/null 2>&1
        [ "$(qdbus "$svc" "$w" currentSession 2>/dev/null)" = "$sid" ] && return 0
      done
      return 0
    done
  done
  return 1
}
wjson=$(wezterm cli --no-auto-start list --format json 2>/dev/null)

# activate the tab running tmux client $1 and raise its window via wxmap's
# exact X id, verified against wezterm's focus report; falls back to a
# focus probe (may briefly flash a wrong window) when wxmap declines or the
# check fails. Target IS the focused window → the tab switch is enough.
surface() {
  local pane="" wid="" x=""
  local -a cands=()
  read -r pane wid < <(printf '%s' "$wjson" |
    jq -r --arg t "$1" '.[] | select(.tty_name == $t) | "\(.pane_id) \(.window_id)"' 2>/dev/null | head -1)
  if [ -z "$wid" ]; then    # not a wezterm surface → konsole driver
    konsole_surface "$1"; return $?
  fi
  [ -n "$pane" ] && wezterm cli --no-auto-start activate-pane --pane-id "$pane" >/dev/null 2>&1
  [ "$fcls" = "org.wezfurlong.wezterm" ] && [ "$wid" = "$lwid" ] && return 0   # your own window: done
  [ -n "$wid" ] || { raise "$(wxid)"; return 0; }
  x=$(wxmap "$wid")
  if [ -n "$x" ]; then
    raise "$x"; sleep 0.12   # let wezterm register the X focus
    [ "$(fwid_of)" = "$wid" ] && return 0
  fi
  # probe: focus each candidate in turn, ask wezterm which pane received it
  mapfile -t cands < <(i3-msg -t get_tree 2>/dev/null |
    jq -r '.. | objects | select(.window_properties?.class? == "org.wezfurlong.wezterm") | .window')
  for x in "${cands[@]}"; do
    raise "$x"
    for _ in 1 2; do
      sleep 0.12
      [ "$(fwid_of)" = "$wid" ] && return 0
    done
  done
  # nothing confirmed — the last candidate stays raised
}

# ltty/lwid: tty + internal window of the pane you last touched — wezterm
# remembers it even while X focus is elsewhere. ftty: what you're LOOKING
# at — wezterm's pane report when wezterm holds X focus, konsole's active
# tab (DBus) when konsole does. Neither is guaranteed to be a tmux client.
# .[0] = single GUI instance.
ltty=""; lwid=""; ftty=""; fxid=""; fcls=""
fpane=$(wezterm cli --no-auto-start list-clients --format json 2>/dev/null |
  jq -r '.[0].focused_pane_id // empty')
if [ -n "$fpane" ]; then
  read -r ltty lwid < <(printf '%s' "$wjson" | jq -r --argjson p "$fpane" '
    .[] | select(.pane_id == $p) | "\(.tty_name // "-") \(.window_id)"' 2>/dev/null | head -1)
fi
tmux list-clients -F '#{client_name}' 2>/dev/null | grep -qx "$ltty" || ltty=""
read -r fcls fxid < <(i3-msg -t get_tree 2>/dev/null | jq -r '
  [.. | objects | select(.focused? == true and .window != null) |
   "\(.window_properties.class // "-") \(.window)"][0] // "- -"')
if [ "$fcls" = "org.wezfurlong.wezterm" ]; then
  ftty=$ltty
elif [ "$fcls" = "konsole" ] && [ -n "$fxid" ]; then
  ftty=$(konsole_ftty "$fxid")
fi
tmux list-clients -F '#{client_name}' 2>/dev/null | grep -qx "$ftty" || ftty=""

# local jump targets: every attached client that is not an sshd or
# mosh-server descendant — remote attaches retune views nobody looks at.
# wezterm-ness only gates the raise machinery now.
lcl=""
while IFS= read -r c; do
  pid=${c%% *}; tty=${c##* }
  if ! anc_pid "$pid" sshd >/dev/null && ! anc_pid "$pid" mosh-server >/dev/null; then
    lcl+="${lcl:+|}$tty"
  fi
done < <(tmux list-clients -F '#{client_pid} #{client_name}' 2>/dev/null)

# Landing ladder — never steal a surface's session when one already shows it:
# ① you're looking at that session right now → select window/pane in place
if [ -n "$ftty" ] && [ "$(tmux display-message -p -t "$ftty" '#{session_name}' 2>/dev/null)" = "$sess" ]; then
  jump "$ftty"; exit 0
fi
# ② a local surface is already attached → go there; several share the
# session → the one you last touched wins (switch-client re-selects the
# session it already shows: a no-op anchor for the selects)
att=""
[ -n "$lcl" ] && att=$(tmux list-clients -t "$sess" -F '#{client_activity} #{client_name}' 2>/dev/null |
  awk -v p="|$lcl|" -v f="$ltty" 'index(p, "|" $2 "|") {print ($2==f ? 2 : 1), $1, $2}' |
  sort -rn | head -1 | cut -d' ' -f3)
if [ -n "$att" ]; then
  jump "$att"; surface "$att"; exit 0
fi
# ③ nobody local shows it → retune the surface you're looking at
[ -n "$ftty" ] && { jump "$ftty"; exit 0; }

# from a non-tmux surface: retune the most recent local client and raise
# it; all clients remote → settle for the most recent of those
client=""
[ -n "$lcl" ] && client=$(tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null |
  awk -v p="|$lcl|" 'index(p, "|" $2 "|")' | sort -rn | head -1 | cut -d' ' -f2)
[ -n "$client" ] || client=$(tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null |
  sort -rn | head -1 | cut -d' ' -f2)
[ -n "$client" ] || exit 0
jump "$client"; surface "$client"
