#!/usr/bin/env bash
# agent-rofi — desktop agent picker: list agents (@pane_* from
# tmux-agent-sidebar), Enter jumps to the agent: prefer a surface already
# attached to its session (raise that), else retune the one you're looking at.
#   agent-rofi --dry-run  print rows + jump targets, no rofi
set -u
# AGENT_ROFI_DEBUG=1 → xtrace to /tmp/agent-rofi-debug.log
[ "${AGENT_ROFI_DEBUG:-}" = 1 ] && { exec 2>/tmp/agent-rofi-debug.log; set -x; }

mapfile -t rows < <(tmux list-panes -a -F \
  '#{pane_id}|#{@pane_agent}|#{@pane_status}|#{window_name}|#{session_name}' 2>/dev/null |
  awk -F'|' '$2 != ""')

[ ${#rows[@]} -eq 0 ] && { command -v notify-send >/dev/null && notify-send -u low "agent-rofi" "no agents running"; exit 0; }

display=()
for r in "${rows[@]}"; do
  IFS='|' read -r pane agent status win sess <<<"$r"
  case $status in   # One Dark status colors; emoji keep their own
    waiting)    dot='<span foreground="#E06C75">⏳</span>' ;;
    running)    dot='<span foreground="#E5C07B">⚡</span>' ;;
    background) dot='<span foreground="#5C6370">🌙</span>' ;;
    idle)       dot='<span foreground="#98C379">💤</span>' ;;
    *)          dot='<span foreground="#5C6370">?</span>' ;;
  esac

  # name ← ~/.claude/sessions via @pane_session_id, else cwd basename
  # (window_name degrades to the foreground command). @pane_prompt rides
  # along as context. tmux escapes control chars, so | separates — the
  # prompt is last and read keeps it verbatim, embedded | included.
  sid=""; cwd=""; prompt=""
  IFS='|' read -r sid cwd prompt < <(tmux display-message -p -t "$pane" \
    '#{@pane_session_id}|#{@pane_cwd}|#{@pane_prompt}' 2>/dev/null)
  name=""
  [ -n "$sid" ] &&
    name=$(jq -r --arg s "$sid" 'select(.sessionId == $s) | .name' \
      "$HOME"/.claude/sessions/*.json 2>/dev/null | head -1)
  [ -z "$name" ] && [ -n "$cwd" ] && name=${cwd##*/}
  [ -z "$name" ] && name=$win

  read -r prompt <<<"$prompt"                 # first line, trimmed
  [ ${#prompt} -gt 48 ] && prompt="${prompt:0:48}…"
  # markup rows: neutralize any &<> in interpolated text
  name=${name//&/&amp;} name=${name//</&lt;} name=${name//>/&gt;}
  prompt=${prompt//&/&amp;} prompt=${prompt//</&lt;} prompt=${prompt//>/&gt;}

  line="$dot  ${agent} · ${name:-?}"
  [ -n "$prompt" ] && line+="   <span foreground=\"#5C6370\" size=\"smaller\">${prompt}</span>"
  display+=("$line")
done

if [ "${1:-}" = "--dry-run" ]; then
  for i in "${!rows[@]}"; do
    IFS='|' read -r pane agent status win sess <<<"${rows[i]}"
    printf '%s   -> jump session=%s pane=%s\n' "${display[i]}" "$sess" "$pane"
  done
  exit 0
fi

# agents.rasi → mine.rasi for the desktop look; plain default if it's gone
targs=(-normal-window)
[ -f "$HOME/.config/rofi/agents.rasi" ] && targs+=(-theme "$HOME/.config/rofi/agents.rasi")
idx=$(printf '%s\n' "${display[@]}" |
  rofi -dmenu -i -markup-rows -format i -p agents "${targs[@]}" 2>/dev/null)
[ -z "$idx" ] && exit 0    # Esc / no selection
[[ $idx =~ ^[0-9]+$ ]] && (( idx < ${#rows[@]} )) || exit 0   # -format i is 0-based
sleep 0.15   # let i3 hand focus back after rofi closes, or it yanks it later

IFS='|' read -r pane agent status win sess <<<"${rows[idx]}"

jump() { tmux switch-client -c "$1" -t "$sess" \; select-window -t "$pane" \; select-pane -t "$pane"; }
# exact-id focus only — bare class focus marches i3 through every match
raise() { [ -n "$1" ] && i3-msg "[id=$1] focus" >/dev/null 2>&1; }
wxid()  { i3-msg -t get_tree 2>/dev/null |
  jq -r '.. | select(.window_properties?.class? == "org.wezfurlong.wezterm") | .window' | head -1; }
# wezterm's window that currently holds its GUI focus (X-focus driven)
fwid_of() {
  local pf
  pf=$(wezterm cli --no-auto-start list-clients --format json 2>/dev/null |
    jq -r '.[0].focused_pane_id // empty')
  printf '%s' "$wjson" |
    jq -r --argjson p "${pf:-0}" '.[] | select(.pane_id == $p) | .window_id // empty' 2>/dev/null | head -1
}
# internal wezterm window_id → X id. wezterm's CLI exposes no X ids, but
# both id spaces are creation-ordered and each wezterm window owns exactly
# one X window (created and destroyed together) — zipping the two sorted
# lists pairs them for any number of windows. Counts disagree (stray
# same-class window / second GUI instance) → no mapping, caller probes.
wxmap() {
  local a b
  a=$(printf '%s' "$wjson" | jq -r '[.[].window_id] | unique | .[]' 2>/dev/null)
  b=$(i3-msg -t get_tree 2>/dev/null |
    jq -r '[.. | objects | select(.window_properties?.class? == "org.wezfurlong.wezterm") | .window] | sort | .[]')
  [ "$(printf '%s\n' "$a" | grep -c .)" = "$(printf '%s\n' "$b" | grep -c .)" ] || return 1
  paste <(printf '%s\n' "$a") <(printf '%s\n' "$b") | awk -v w="$1" '$1 == w {print $2; exit}'
}
wjson=$(wezterm cli --no-auto-start list --format json 2>/dev/null)

# activate the wezterm tab whose pane runs tmux client $1, and raise its
# window by exact X id via wxmap's creation-order pairing — no titles, no
# probing, any number of windows. The raise is verified through wezterm's
# own focus report; on mismatch (or when wxmap declines) fall back to the
# focus probe, which may briefly flash a wrong window. Target IS the
# focused window → the tab switch alone is enough.
surface() {
  local pane="" wid="" x=""
  local -a cands=()
  read -r pane wid < <(printf '%s' "$wjson" |
    jq -r --arg t "$1" '.[] | select(.tty_name == $t) | "\(.pane_id) \(.window_id)"' 2>/dev/null | head -1)
  [ -n "$pane" ] && wezterm cli --no-auto-start activate-pane --pane-id "$pane" >/dev/null 2>&1
  [ -n "$fxid" ] && [ "$wid" = "$lwid" ] && return 0   # your own window: done
  [ -n "$wid" ] || { raise "$(wxid)"; return 0; }
  x=$(wxmap "$wid")
  if [ -n "$x" ]; then
    raise "$x"; sleep 0.12   # let wezterm register the X focus
    [ "$(fwid_of)" = "$wid" ] && return 0
  fi
  # probe: focus each candidate in turn, ask wezterm which pane received it
  mapfile -t cands < <(i3-msg -t get_tree 2>/dev/null |
    jq -r '.. | objects | select(.window_properties?.class? == "org.wezfurlong.wezterm") | .window')
  for x in "${cands[@]}"; do
    raise "$x"
    for _ in 1 2; do
      sleep 0.12
      [ "$(fwid_of)" = "$wid" ] && return 0
    done
  done
  # nothing confirmed — the last candidate stays raised
}

# wezterm's GUI focus: list-clients names the pane you last touched — that
# stays valid even while X focus sits in another app (chrome), which is
# exactly when "where was I" matters. ltty/lwid: that surface's tty /
# internal window id. ftty: the surface you're LOOKING at — only when a
# wezterm window truly holds X focus (fxid). A last-touched tab may not be
# a tmux client (ssh / plain shell) → ltty empty. .[0] = single GUI.
ltty=""; lwid=""; ftty=""; fxid=""
fpane=$(wezterm cli --no-auto-start list-clients --format json 2>/dev/null |
  jq -r '.[0].focused_pane_id // empty')
if [ -n "$fpane" ]; then
  read -r ltty lwid < <(printf '%s' "$wjson" | jq -r --argjson p "$fpane" '
    .[] | select(.pane_id == $p) | "\(.tty_name // "-") \(.window_id)"' 2>/dev/null | head -1)
fi
tmux list-clients -F '#{client_name}' 2>/dev/null | grep -qx "$ltty" || ltty=""
fxid=$(i3-msg -t get_tree 2>/dev/null | jq -r '
  .. | select(.focused? == true and .window_properties?.class? == "org.wezfurlong.wezterm") | .window // empty' | head -1)
[ -n "$fxid" ] && ftty=$ltty

# local surfaces only: ttys that belong to a wezterm pane (remote ssh
# attachés have none and can't be raised anyway)
wtty=""
[ -n "$wjson" ] && wtty=$(printf '%s' "$wjson" |
  jq -r '[.[].tty_name // empty] | join("|")' 2>/dev/null)

# Landing ladder — never steal a surface's session when a surface already
# shows the agent's session:
# ① you're looking at that session right now → select window/pane in place
if [ -n "$ftty" ] && [ "$(tmux display-message -p -t "$ftty" '#{session_name}' 2>/dev/null)" = "$sess" ]; then
  jump "$ftty"; exit 0
fi
# ② a local surface is already attached to it → go there (switch-client
# re-selects the session it already shows: no-op anchor for the selects);
# several surfaces share the session → the one you last touched wins over
# bare activity — "where I was just working" beats a timestamp
att=""
[ -n "$wtty" ] && att=$(tmux list-clients -t "$sess" -F '#{client_activity} #{client_name}' 2>/dev/null |
  awk -v p="|$wtty|" -v f="$ltty" 'index(p, "|" $2 "|") {print ($2==f ? 2 : 1), $1, $2}' |
  sort -rn | head -1 | cut -d' ' -f3)
if [ -n "$att" ]; then
  jump "$att"; surface "$att"; exit 0
fi
# ③ nobody local shows it → retune the surface you're looking at
[ -n "$ftty" ] && { jump "$ftty"; exit 0; }

# invoked from a non-tmux surface (ssh tab / other app): retune the most
# recently active local client and raise it; wezterm down → any client
client=""
[ -n "$wtty" ] && client=$(tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null |
  awk -v p="|$wtty|" 'index(p, "|" $2 "|")' | sort -rn | head -1 | cut -d' ' -f2)
[ -n "$client" ] || client=$(tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null |
  sort -rn | head -1 | cut -d' ' -f2)
[ -n "$client" ] || exit 0
jump "$client"; surface "$client"
