#!/usr/bin/env python3
"""agent-server — mobile status viewer + live terminal for agents in tmux.

Thin layer over the @pane_* pane options that tmux-agent-sidebar maintains.
Status is read live via `tmux list-panes` on every request (nothing cached);
terminals mirror ONE agent pane (capture-pane dump + pipe-pane stream,
send-keys input) — the phone sees the agent's own screen, no tmux chrome.

  agent-server [--port 7678] [--bind 0.0.0.0]
      HTTP on --port: page + /api/status + /api/preview
      WS   on port+1: /api/term/<pane> (xterm.js on the phone)

Endpoints (all but / require ?token=):
  /                      embedded single-page UI (list, preview, terminal)
  /api/status            agent rows as JSON
  /api/preview/<pane>    last 30 lines of the pane (tmux capture-pane)
  /api/term/<pane>  (WS) live terminal: binary frames = tty bytes, first
                         text frame {"cols","rows"} sets the pty size

Token: generated once into ~/.config/agent-server/token (0600). The startup
banner prints phone URLs. No TLS — keep it on LAN/Tailscale; the token only
guards the API, and /api/term hands out the agent keyboard.
"""
import argparse
import asyncio
import glob
import gzip
import hashlib
import json
import os
import re
import secrets
import subprocess
import sys
import threading
import time
import urllib.request
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

import websockets

CONF_DIR = os.path.expanduser("~/.config/agent-server")
FIELDS = "#{pane_id}\t#{@pane_agent}\t#{@pane_status}\t#{window_name}\t#{session_name}\t#{pane_current_path}\t#{@pane_started_at}\t#{@pane_notification_run_id}\t#{@pane_session_id}"
PANE_RE = re.compile(r"^%\d+$")
ASSETS = {
    "/assets/xterm.js": ("text/javascript; charset=utf-8", "xterm.js"),
    "/assets/xterm.css": ("text/css; charset=utf-8", "xterm.css"),
    "/assets/fit.js": ("text/javascript; charset=utf-8", "fit.js"),
}
TOKEN = ""
TMUX = "/usr/bin/tmux" if os.path.exists("/usr/bin/tmux") else "tmux"
ASSET_GZ = {}        # path -> precompressed bytes; xterm.js is 283KB and
                     # would cost ~10ms CPU on every page load otherwise
ASSET_URLS = {
    "xterm.js": "https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.min.js",
    "xterm.css": "https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.min.css",
    "fit.js": "https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.js",
}


def ensure_assets():
    """Self-bootstrap on a fresh machine: fetch missing terminal assets once
    (a first terminal open would 404 otherwise — `dot install` ships no
    vendor files by design). Best-effort; offline just means no ⌨."""
    d = os.path.join(CONF_DIR, "assets")
    os.makedirs(d, exist_ok=True)
    for name, url in ASSET_URLS.items():
        p = os.path.join(d, name)
        if os.path.exists(p) and os.path.getsize(p) > 0:
            continue
        try:
            with urllib.request.urlopen(url, timeout=30) as r, open(p, "wb") as f:
                f.write(r.read())
        except Exception:
            pass


def bad_token(query):
    t = parse_qs(query).get("token", [""])[0]
    return not (t.isascii() and secrets.compare_digest(t, TOKEN))


def load_token():
    os.makedirs(CONF_DIR, exist_ok=True)
    path = os.path.join(CONF_DIR, "token")
    try:
        with open(path) as f:
            t = f.read().strip()
            if t:
                return t
    except FileNotFoundError:
        pass
    t = secrets.token_hex(12)
    with open(path, "w") as f:
        f.write(t)
    os.chmod(path, 0o600)
    return t


TITLE_CACHE = {}          # sid -> (fetched_at, title); 60s TTL


def session_title(sid):
    """Last custom-title, else last ai-title, from the session's jsonl tail.
    Cached — the list polls every 2s and must not tail N files each time."""
    if not sid:
        return ""
    now = time.time()
    c = TITLE_CACHE.get(sid)
    if c and now - c[0] < 60:
        return c[1]
    title = ""
    p = transcript_path(sid)
    if p:
        try:
            size = os.path.getsize(p)
            with open(p, "rb") as fh:
                fh.seek(max(0, size - 65536))
                tail = fh.read().decode(errors="replace")
            ai = ""
            for line in tail.splitlines():
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if e.get("type") == "custom-title" and e.get("customTitle"):
                    title = e["customTitle"]        # keep the last one
                elif e.get("type") == "ai-title" and e.get("aiTitle"):
                    ai = e["aiTitle"]
            title = title or ai
        except OSError:
            pass
    TITLE_CACHE[sid] = (now, title)
    if len(TITLE_CACHE) > 64:            # cap: drop the oldest beyond 64
        for k in sorted(TITLE_CACHE, key=lambda k: TITLE_CACHE[k][0])[:len(TITLE_CACHE) - 64]:
            del TITLE_CACHE[k]
    return title


PMODE_MAP = {"default": "manual", "acceptEdits": "accept edits",
             "plan": "plan", "auto": "auto", "bypassPermissions": "bypass"}
USAGE_CACHE = {}   # path -> ((size, mtime_ns), ctx, out, pmode) — the chat
                   # poll hits this every 700ms; skip the tail read when the
                   # transcript has not changed


def session_usage(path):
    """Token usage from the newest assistant entry's usage record.
    ctx = input + cache_read + cache_creation ≈ what the next call re-reads."""
    try:
        st = os.stat(path)
    except OSError:
        return None, None
    sig = (st.st_size, st.st_mtime_ns)
    hit = USAGE_CACHE.get(path)
    if hit and hit[0] == sig:
        return hit[1], hit[2], hit[3]
    ctx = out = pmode = None
    try:
        with open(path, "rb") as fh:
            fh.seek(max(0, st.st_size - 65536))
            tail = fh.read().decode(errors="replace")
        for line in reversed(tail.splitlines()):
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if pmode is None and e.get("permissionMode"):
                pmode = PMODE_MAP.get(e["permissionMode"], e["permissionMode"])
            if ctx is None:
                u = (e.get("message") or {}).get("usage")
                if u and u.get("input_tokens") is not None:
                    ctx = (u.get("input_tokens", 0)
                           + u.get("cache_read_input_tokens", 0)
                           + u.get("cache_creation_input_tokens", 0))
                    out = u.get("output_tokens", 0)
            if ctx is not None and pmode is not None:
                break
    except OSError:
        pass
    USAGE_CACHE[path] = (sig, ctx, out, pmode)
    return ctx, out, pmode


def agent_rows():
    try:
        out = subprocess.run(
            [TMUX, "list-panes", "-a", "-F", FIELDS],
            capture_output=True, text=True, errors="replace",
            timeout=3,
        ).stdout
    except Exception:
        return []
    rows = []
    now = time.time()
    for line in out.splitlines():
        f = line.split("\t")
        if len(f) != 9 or not f[1]:
            continue
        ts = 0.0
        for cand in (f[6], f[7]):             # started_at(s) / run_id(ms)
            if cand.isdigit():
                v = int(cand)
                if v > 10**12:
                    v /= 1000.0
                ts = max(ts, v)
        age = ""
        if ts:
            sec = max(0, int(now - ts))
            age = f"{sec}s" if sec < 60 else f"{sec//60}m" if sec < 3600 else f"{sec//3600}h"
        rows.append({
            "pane": f[0], "agent": f[1], "status": f[2],
            "window": f[3] or "?", "session": f[4],
            "project": os.path.basename(f[5]) or f[5] or "?",
            "ts": ts, "age": age, "title": session_title(f[8]),
        })
    return rows


def pane_preview(pane):
    if not PANE_RE.match(pane):
        return "(bad pane id)"
    try:
        return subprocess.run(
            [TMUX, "capture-pane", "-p", "-S", "-30", "-t", pane],
            capture_output=True, text=True, errors="replace",
            timeout=3,
        ).stdout.rstrip("\n")
    except Exception:
        return "(capture failed — pane gone?)"


def pane_geometry(pane):
    """(cols, rows, session) of a pane, or None when it is gone."""
    try:
        out = subprocess.run(
            [TMUX, "display-message", "-p", "-t", pane,
             "#{pane_width} #{pane_height} #{session_name}"],
            capture_output=True, text=True, errors="replace",
            timeout=3,
        ).stdout.strip()
    except Exception:
        return None
    f = out.split(" ", 2)            # session names may contain spaces —
    if len(f) != 3 or not (f[0].isdigit() and f[1].isdigit()):  # cols/rows
        return None                  # never do
    return int(f[0]), int(f[1]), f[2]


def transcript_path(session_id):
    if not re.match(r"^[0-9a-f-]{36}$", session_id):
        return None
    import glob
    hits = glob.glob(os.path.expanduser(
        f"~/.claude/projects/*/{session_id}.jsonl"))
    return hits[0] if hits else None


def read_chat(path, after):
    """Messages from the transcript after byte offset `after` (append-only).

    Returns (new_offset, messages). User texts and assistant text blocks
    become chat messages; tool calls collapse to a one-liner. Sidechain
    (subagent) entries and system wrappers are skipped.
    """
    try:
        size = os.path.getsize(path)
    except OSError:
        return after, after, []
    try:
        with open(path, "rb") as f:
            if after < 0 or after > size or after < size - 262144:
                after = max(0, size - 131072)   # first fetch / stale client:
                f.seek(after)                   # clamp, never parse the whole
                nl = f.read(4194304).find(b"\n")  # history — and align FORWARD
                if nl >= 0:                     # to a line start: the clamp
                    after += nl + 1             # can land inside ONE giant
            f.seek(after)                       # record (a 344KB compact
            chunk = f.read().decode(errors="replace")   # summary line) and
    except OSError:                             # tear it apart
        return after, after, []
    cut = chunk.rfind("\n")                  # keep the partial tail for next poll
    if cut < 0:
        return after, after, []
    return after + cut + 1, after, parse_msgs(chunk[:cut].splitlines())


def parse_msgs(lines):
    msgs = []
    for line in lines:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("isSidechain"):
            continue
        etype, ts = e.get("type"), e.get("timestamp", "")
        if etype == "user" and e.get("isMeta"):
            continue               # local-command OUTPUT panels (/context,
            # /compact stdout) — machine-injected, not a user message
        content = (e.get("message") or {}).get("content")
        if etype == "user" and isinstance(content, str):
            content = [{"type": "text", "text": content}]
        if not isinstance(content, list):
            continue
        for b in content:
            if not isinstance(b, dict):
                continue
            if etype == "user" and b.get("type") == "text":
                t = b.get("text", "").strip()
                if not t:
                    continue
                if e.get("isCompactSummary"):   # /compact's landing summary —
                    msgs.append({"role": "compact", "ts": ts, "text": t})
                    continue                    # its own card, not a user bubble
                mc = re.match(r"<command-name>(.*?)</command-name>", t)
                if mc and mc.group(1) == "/compact":
                    continue   # wrapper echo lands AFTER the summary card; the
                # raw "/compact" prompt record before it is the trigger chip
                if mc:                  # slash command run in the TUI
                    msgs.append({"role": "user", "ts": ts, "text": mc.group(1)})
                elif not t.startswith(("<local-command", "<task-notification",
                                        "<system-reminder")):
                    # a prompt may OPEN with a paste — collapse the payload,
                    # keep the user's own words around it. The closing tag is
                    # usually ABSENT in transcript entries, so also eat the
                    # unterminated tail.
                    t = re.sub(r"\s*<pasted_content[^>]*>.*?(</pasted_content>\s*|$)",
                               "\n📎 粘贴内容", t, flags=re.S).strip()
                    msgs.append({"role": "user", "ts": ts, "text": t,
                                 "pu": e.get("parentUuid", "")})
            elif etype == "assistant" and b.get("type") == "text":
                t = b.get("text", "").strip()
                if t:
                    msgs.append({"role": "assistant", "ts": ts, "text": t})
            elif etype == "assistant" and b.get("type") == "tool_use":
                name = b.get("name", "tool")
                brief = ""
                inp = b.get("input") if isinstance(b.get("input"), dict) else {}
                for k in ("command", "file_path", "pattern", "description",
                          "query", "url", "path"):
                    v = inp.get(k)
                    if isinstance(v, str) and v.strip():
                        brief = v.strip().split("\n")[0][:60]
                        break
                msgs.append({"role": "tool", "ts": ts,
                             "text": name + (": " + brief if brief else "")})
            elif etype == "assistant" and b.get("type") == "thinking":
                t = (b.get("thinking") or b.get("text") or "").strip()
                if t:
                    msgs.append({"role": "think", "ts": ts, "text": t[:2000]})
    return msgs


def read_chat_before(path, before, window=262144):
    """One older page ENDING at byte `before` (a line boundary) — the chat's
    load-older pill pages history backwards. start==0 means fully loaded."""
    try:
        size = os.path.getsize(path)
    except OSError:
        return before, True, []
    before = min(before, size)
    for grow in (window, 4 * window, 16 * window):
        # one record can outweigh the whole page — a compact summary ran
        # 344KB on a SINGLE line, and a window landing inside it holds no
        # newline to align on: grow until one shows up
        base = max(0, before - grow)
        try:
            with open(path, "rb") as f:
                f.seek(base)
                raw = f.read(before - base)
        except OSError:
            return before, False, []
        if base == 0:
            return 0, True, parse_msgs(
                raw.decode(errors="replace").split("\n"))
        nl = raw.find(b"\n")
        if nl < 0:
            continue                    # window inside one giant line
        ideal = before - window - base  # newest boundary that still fits one
        idx = raw.find(b"\n", max(0, ideal))   # page; if the ideal span is
        if base + idx + 1 >= before:    # ONE giant line, its own tail newline
            idx = raw.rfind(b"\n", 0, idx)     # is degenerate (start==before):
            if idx < 0:                 # page the giant WHOLE instead — back
                continue                # up to the boundary before its head
        start = base + (idx if idx >= 0 else nl) + 1
        return start, False, parse_msgs(
            raw[start - base:].decode(errors="replace").split("\n"))
    return before, False, []




# keys the phone may send as {"key": ...} — tmux key names only, no shell
KEY_WHITELIST = {"Enter", "Escape", "Tab", "BTab", "BSpace", "Up", "Down", "Left", "Right", "C-c"}


def transcript_pending_tool(path):
    """The unanswered tool_use the transcript ends on: (name, summary,
    started_ts), None when a user/result entry already closed it. Truthy/
    falsy keeps serving the permission gate; the tuple feeds the live-status
    fallback for panes whose working line a full-screen tool pushed away."""
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            f.seek(max(0, size - 16384))
            lines = f.read().decode(errors="replace").splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("isSidechain"):
            continue
        t = e.get("type")
        if t == "assistant":
            blocks = (e.get("message") or {}).get("content") or []
            for b in reversed(blocks):        # newest tool_use in the message
                if isinstance(b, dict) and b.get("type") == "tool_use":
                    inp = b.get("input") or {}
                    summ = ""
                    for k in ("command", "file_path", "pattern", "description",
                              "query", "url", "path", "prompt"):
                        if inp.get(k):
                            summ = str(inp[k])[:4096]  # the perm card scrolls
                            break                      # — show it whole
                    try:
                        dt = datetime.fromisoformat(
                            e["timestamp"].replace("Z", "+00:00"))
                        if dt.tzinfo is None:   # no Z suffix → UTC, not
                            dt = dt.replace(tzinfo=timezone.utc)  # local tz
                        ts = dt.timestamp()
                    except (KeyError, ValueError):
                        ts = None
                    return b.get("name", "?"), summ, ts
            return None
        if t == "user":                       # a result/response came after
            return None
    return None


def parse_opts(text):
    """Numbered dialog options in the given text, classified two-pass:
    always/deny from the bottom up, allow as the lowest unclaimed yes."""
    cands = []
    for line in text.splitlines():
        m = re.match(r"\s*[❯> ]?\s*([1-9])[.)]\s*(.+?)\s*$", line)
        if m:
            cands.append((m.group(1), m.group(2).lower()))
    opts = {}
    for num, txt in reversed(cands):   # bottom-most wins: the live dialog
        if re.search(r"don'?t|do not|always|不再", txt):   # sits below any
            opts.setdefault("always", num)                 # numbered list
        elif re.match(r"^(no|deny|skip|cancel|not now|拒绝)", txt):  # in
            opts.setdefault("deny", num)                   # transcript
        elif (re.match(r"^yes[,，]", txt) and "auto" not in txt
              and "switch" not in txt):
            opts.setdefault("always", num)   # "Yes, allow … this session"
            # — the wide-grant middle option; auto-mode switchers are NOT
            # a don't-ask-again and must not wear that button's label
    for num, txt in cands:             # allow: LOWEST number whose line is
        if (num != opts.get("always") and num != opts.get("deny")   # a plain
                and re.match(r"^(yes|allow|proceed|approve|允许)", txt)):
            opts.setdefault("allow", num)   # yes — a phrasing variant on a
            break                           # higher option must not steal it
    return opts


def detect_perm(pane):
    """Parse the LIVE screen for a permission dialog (ground truth — the
    @pane_wait_reason latch can be stale in both directions).

    Claude Code dialogs end in numbered option lines; require at least two
    recognizable options before claiming a dialog is up, and return the
    actual numbers so the buttons always match the screen.
    """
    try:
        out = subprocess.run(
            [TMUX, "capture-pane", "-p", "-S", "-12", "-t", pane],
            capture_output=True, text=True, errors="replace",
            timeout=3,
        ).stdout
    except Exception:
        return None
    opts = parse_opts(out)
    if len(opts) >= 2:
        return opts
    # y/n banner ("y to continue · n to cancel") — the auto-mode billing
    # notice on gateway setups: sets waiting but has NO numbered options
    if (re.search(r"\by to (continue|proceed|accept)", out, re.I)
            and re.search(r"\bn to (cancel|deny|skip|stop)", out, re.I)):
        return {"allow": "y", "deny": "n"}
    return None


def perm_gate(screen, status, path, pane):
    """Permission bar decision. A LIVE dialog is pinned to the screen
    bottom: options plus a confirm hint ('Enter to confirm' / 'y to
    continue') within the last few lines. Detecting it there — from the
    capture every poll already takes — shows the bar immediately, without
    waiting for the @pane_status latch (hook-driven and may lag seconds).
    Answered dialogs scroll up and out of that window; the old
    waiting+pending path stays as the fallback for marker-less dialogs."""
    bottom = "\n".join(screen.splitlines()[-10:])
    opts = parse_opts(bottom)
    # confirm-hint markers seen on real dialogs: notice types end with
    # 'Enter to confirm', tool permission ends with 'Esc to cancel'
    marker = re.search(r"enter to confirm|y to continue|esc to cancel", bottom,
                       re.I)
    if opts and marker and opts.get("allow"):
        return opts
    if (re.search(r"\by to (continue|proceed|accept)", bottom, re.I)
            and re.search(r"\bn to (cancel|deny|skip|stop)", bottom, re.I)):
        return {"allow": "y", "deny": "n"}
    if status == "waiting":
        return detect_perm(pane)      # legacy: status latch + own capture
    return None


def capture_tail(pane, lines=24):   # wide enough that a multi-line draft
    # in the TUI input box can't push the working line out of view
    """Read-only snapshot of the pane's last N rendered lines — feeds both
    the footer and the working-line parsers (one subprocess per poll)."""
    try:
        return subprocess.run(
            [TMUX, "capture-pane", "-p", "-S", f"-{lines}", "-t", pane],
            capture_output=True, text=True, errors="replace",
            timeout=3,
        ).stdout
    except Exception:
        return ""


def pane_ctx(text):
    """Context usage % and model from the TUI's own footer line — the same
    number the statusline renders, so no window-size guessing. The [1m]
    window marker nests a second ']' before the bar."""
    for line in reversed(text.splitlines()):
        m = re.search(r"\[([^\]]+)\]+\s*[█▓▒░]{3,}\s*(\d{1,3})%", line)
        if m:
            model = m.group(1)
            if model.endswith("[1m"):
                model += "]"
            return model, int(m.group(2))
    return None, None


def pane_live(text):
    """The TUI's working line — present while thinking AND while tools run:
    '<spinner> <Gerund>… (2m 9s · ↓ 7.4k tokens)'. The transcript only lands
    per completed message, so this screen line is the only live progress.
    The leading glyph is an animated spinner (✶/·/…), so anchor on the
    '… (… · ↓ … tokens)' signature instead of the glyph. /compact paints
    'Compacting conversation… (2s)' — its tokens suffix arrives only once
    the summary starts streaming — so that phase gets its own label; the
    ↑ direction covers the SessionStart-hook line after a compact."""
    for line in text.splitlines():
        m = re.search(r"Compacting conversation… \(([^()]*)\)", line)
        if m:
            return "compacting", m.group(1).replace(" tokens", "")
        m = re.search(r"(\S+)… \(([^()]*· [↓↑] [^()]*tokens)\)", line)
        if m:
            return m.group(1), m.group(2).replace(" tokens", "")
    return None, None


MODE_NAMES = {                        # normalized TUI phrase -> chip label
    "auto": "auto", "accept edits": "accept edits", "plan": "plan",
    "manual": "manual", "bypass": "bypass", "bypass permissions": "bypass",
}


def pane_mode(text):
    """Permission mode from the TUI's bottom hint line. The line is
    glyph-prefixed ('⏵⏵ auto mode on (shift+tab …)' / '⏸ manual mode on · …')
    — manual mode OMITS the (shift+tab) suffix, so anchor on the glyph and
    the terminator. Whitelist-mapped so stray text can't pose as a mode."""
    for line in text.splitlines():
        m = re.search(r"[⏵⏸]+\s*([a-z][a-z ]+?)\s*(?:\(|·)", line)
        if m:
            p = m.group(1).strip().lower()
            p = p.replace(" mode", "").replace(" on", "").strip()
            return MODE_NAMES.get(p)
    return None


def resize_pane(pane, cols, rows):
    subprocess.run(
        [TMUX, "resize-pane", "-t", pane, "-x", str(cols), "-y", str(rows)],
        capture_output=True, timeout=3,
    )


TERM_REFCOUNT = {}                     # pane -> open mirrors


async def term_handler(ws, path):
    """Mirror ONE agent pane, orca-style: the PHONE drives the geometry.

    Flow (orca's terminal.resizeForClient + restore, on tmux primitives):
    1. server sends {"ready": 1}
    2. client fits xterm to its viewport and replies {"cols", "rows"}
       (re-sent on rotation / keyboard toggles)
    3. server resizes the pane to that geometry — the agent redraws at
       phone size and pipe-pane streams it — then sends the effective
       geometry plus a capture-pane dump as the initial screen
    4. on disconnect the LAST viewer closes the pipe and restores the
       pane's original size.

    tmux allows one pipe per pane: the newest connection owns the stream
    (a fast phone reconnect takes over cleanly); refcounting keeps an
    earlier connection's cleanup from tearing down a live viewer's pipe.
    """
    u = urlparse(path)
    if bad_token(u.query):
        await ws.close(code=4403, reason="bad token")
        return
    m = re.match(r"^/api/term/(%\d+)$", u.path)
    if not m:
        await ws.close(code=4400, reason="bad path")
        return
    pane = m.group(1)
    geo = pane_geometry(pane)
    if not geo:
        await ws.send(json.dumps({"error": "pane gone"}))
        await ws.close()
        return
    orig_w, orig_h, _sess = geo
    fifo = f"/tmp/agent-server-{os.getpid()}-{id(ws):x}.fifo"
    fd = -1
    loop = asyncio.get_event_loop()
    TERM_REFCOUNT[pane] = TERM_REFCOUNT.get(pane, 0) + 1
    watchdog = None

    async def death_watch():
        # pipe EOF alone just freezes the reader — poll pane liveness and
        # tell the phone when the pane is really gone
        while True:
            await asyncio.sleep(5)
            if await asyncio.to_thread(pane_geometry, pane) is None:
                try:
                    await ws.send(json.dumps({"error": "pane gone"}))
                except Exception:
                    pass
                await ws.close()
                return

    try:                     # everything below mutates pane state — cleanup
        await ws.send(json.dumps({"ready": 1}))   # must run on ANY exit
        cols = rows = None
        try:
            first = json.loads(await asyncio.wait_for(ws.recv(), timeout=5))
            cols, rows = first.get("cols"), first.get("rows")
        except Exception:
            pass
        if not (isinstance(cols, int) and isinstance(rows, int)
                and 10 <= cols <= 500 and 10 <= rows <= 300):
            cols, rows = orig_w, orig_h          # no usable dims: pane-native
        await asyncio.to_thread(resize_pane, pane, cols, rows)
        # resize-pane is a request — the window layout may clamp it (other
        # panes' minimums), so report the geometry tmux actually granted
        eff = await asyncio.to_thread(pane_geometry, pane)
        if eff:
            cols, rows = eff[0], eff[1]
        await ws.send(json.dumps({"cols": cols, "rows": rows}))

        try:
            init = await asyncio.to_thread(
                subprocess.run,
                [TMUX, "capture-pane", "-e", "-p", "-S", "-2000", "-t", pane],
                capture_output=True, timeout=3)
            await ws.send(init.stdout)
        except Exception:
            pass

        try:
            os.mkfifo(fifo)
        except FileExistsError:
            pass
        await asyncio.to_thread(
            subprocess.run,
            [TMUX, "pipe-pane", "-t", pane, f"cat >{fifo}"],
            capture_output=True, timeout=3)
        fd = os.open(fifo, os.O_RDONLY | os.O_NONBLOCK)

        def pump():
            try:
                data = os.read(fd, 65536)
            except BlockingIOError:
                return
            except OSError:
                data = b""
            if data:
                t = asyncio.ensure_future(ws.send(data))
                # retrieve (to silence) unless cancelled — .exception() on a
                # cancelled task itself raises
                t.add_done_callback(lambda t: t.cancelled() or t.exception())
            else:
                loop.remove_reader(fd)

        loop.add_reader(fd, pump)
        watchdog = asyncio.ensure_future(death_watch())
        watchdog.add_done_callback(lambda t: t.cancelled() or t.exception())
        async for msg in ws:
            if not isinstance(msg, str):
                continue
            try:
                c = json.loads(msg)
            except ValueError:
                continue
            if isinstance(c.get("key"), str) and c["key"] in KEY_WHITELIST:
                await asyncio.to_thread(
                    subprocess.run,
                    [TMUX, "send-keys", "-t", pane, c["key"]],
                    capture_output=True, timeout=3)
            elif isinstance(c.get("text"), str):
                # send-keys argv caps near 128KB per arg — chunk big pastes
                text = c["text"][:32768]
                for i in range(0, len(text), 8192):
                    await asyncio.to_thread(
                        subprocess.run,
                        [TMUX, "send-keys", "-t", pane, "-l", text[i:i + 8192]],
                        capture_output=True, timeout=3)
            elif (isinstance(c.get("cols"), int) and isinstance(c.get("rows"), int)
                    and 10 <= c["cols"] <= 500 and 10 <= c["rows"] <= 300):
                await asyncio.to_thread(resize_pane, pane, c["cols"], c["rows"])
    except (websockets.exceptions.ConnectionClosed, ConnectionError,
            BrokenPipeError):
        pass         # client vanished mid-setup — the finally block is the
                     # part that matters; websockets would log the traceback
    finally:
        if watchdog:
            watchdog.cancel()
        if fd >= 0:
            try:
                loop.remove_reader(fd)
                os.close(fd)
            except OSError:
                pass
        try:
            os.unlink(fifo)
        except OSError:
            pass
        if TERM_REFCOUNT.get(pane, 1) <= 1:
            TERM_REFCOUNT.pop(pane, None)
            await asyncio.to_thread(
                subprocess.run, [TMUX, "pipe-pane", "-t", pane],
                capture_output=True, timeout=3)
            await asyncio.to_thread(resize_pane, pane, orig_w, orig_h)
        else:
            TERM_REFCOUNT[pane] -= 1     # another viewer still mirrors this


