<script>
// xterm (283KB) loads only when a terminal is actually opened — the list
// and chat views never touch it, so first paint is the inline page only.
let xtermReady = null;
function loadXterm() {
  if (xtermReady) return xtermReady;
  xtermReady = new Promise((ok, fail) => {
    let left = 2;
    const done = () => { if (--left === 0) ok(); };
    const boom = () => { xtermReady = null; fail(); };
    const css = document.createElement('link');
    css.rel = 'stylesheet'; css.href = '/assets/xterm.css';
    const s1 = document.createElement('script'); s1.src = '/assets/xterm.js';
    const s2 = document.createElement('script'); s2.src = '/assets/fit.js';
    s1.onload = done; s2.onload = done; s1.onerror = s2.onerror = boom;
    document.head.appendChild(css);
    document.head.appendChild(s1);
    document.head.appendChild(s2);
  });
  return xtermReady;
}
function setVh() {              // keyboard open/shrink must resize overlays
  const h = window.visualViewport ? visualViewport.height : innerHeight;
  document.documentElement.style.setProperty('--vh', h + 'px');
}
setVh();
window.addEventListener('resize', setVh);
if (window.visualViewport) visualViewport.addEventListener('resize', setVh);
const token = new URLSearchParams(location.search).get('token') || '';
const VER = '__VER__';      // replaced at startup; mismatch → hot reload
function chkVer(v) {        // server redeployed the page — pick it up, but
  if (v && v !== VER && VER !== '__VER__' &&   // never eat a typed draft
      !document.getElementById('chat-in').value) location.reload();
}
