  const e = document.getElementById('err');
  e.textContent = msg; e.hidden = false;
  document.getElementById('list').innerHTML = '';
  document.getElementById('empty').hidden = true;
}
function clearErr() { document.getElementById('err').hidden = true; }
/* ---- layer-1 alerts (page open): title badge + beep + vibrate, orca's
   foreground-notification equivalent. Real push stays a separate concern. */
let audioCtx = null, alertMute = false;
try { alertMute = localStorage.getItem('mute') === '1'; } catch {}
const muteBtn = document.getElementById('mute');
muteBtn.textContent = alertMute ? '🔕' : '🔔';
muteBtn.onclick = () => {
  alertMute = !alertMute;
  try { localStorage.setItem('mute', alertMute ? '1' : '0'); } catch {}
  muteBtn.textContent = alertMute ? '🔕' : '🔔';
};
function beep(seq) {
  if (alertMute) return;
  try {
    audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    let t = audioCtx.currentTime;
    for (const [f, d] of seq) {
      const o = audioCtx.createOscillator(), g = audioCtx.createGain();
      o.frequency.value = f; o.connect(g); g.connect(audioCtx.destination);
      g.gain.setValueAtTime(0.12, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + d);
      o.start(t); o.stop(t + d);
      t += d + 0.12;
    }
  } catch {}
}
const prevSt = {};
let waitRows = [];
function diffAlerts(rows) {
  let nWait = 0, newWait = false;
  for (const r of rows) {
    const was = prevSt[r.pane];
    prevSt[r.pane] = r.status;
    if (r.status === 'waiting') nWait++;
    if (r.status === 'waiting' && was && was !== 'waiting') newWait = true;
    else if (was === 'running' && (r.status === 'idle' || r.status === 'background'))
      beep([[520, 0.12]]);                // a task finished — one soft ping
  }
  document.title = nWait ? `(${nWait}) agents ⏳` : 'agents';
  // banner: only agents OTHER than the chat we're already inside —
  // jumping to a waiting agent IS handling it, don't nag about yourself
  waitRows = rows.filter(r => r.status === 'waiting' && r.pane !== chatPane);
  const bar = document.getElementById('wbar');   // the one mobile-visible
  bar.hidden = !waitRows.length                  // layer-1 signal; hidden
             || document.getElementById('term').classList.contains('on');
  if (waitRows.length) {
    const w = waitRows[0];
    bar.textContent = `⏳ ${w.title || w.window} 等待授权` +
                      (waitRows.length > 1 ? ` +${waitRows.length - 1}` : '');
    // list view: snackbar at the bottom; inside a chat the bottom belongs
    // to the composer, so dock the pill under the header instead
    const inChat = document.getElementById('chat').classList.contains('on');
    bar.style.top = inChat ? 'calc(56px + env(safe-area-inset-top))' : 'auto';
    bar.style.bottom = inChat ? 'auto'
                             : 'calc(16px + env(safe-area-inset-bottom))';
  }
  if (newWait) {
    beep([[880, 0.15], [660, 0.15], [880, 0.25]]);
    if (!alertMute && navigator.vibrate) navigator.vibrate([150, 80, 150]);
  }
}
document.getElementById('wbar').onclick = () => {
  if (waitRows[0]) openChat(waitRows[0].pane, waitRows[0]);
};
async function tick() {
  const t0 = performance.now();
  let res;
  try { res = await fetch(`/api/status?token=${token}`); }
  catch { return; }
  const ms = Math.round(performance.now() - t0);
  const ping = document.getElementById('ping');
  ping.textContent = ms + 'ms';
  ping.style.color = ms < 40 ? '#3a4160' : ms < 120 ? '#f9e2af' : '#f38ba8';
  if (!res.ok) {
    setErr(res.status === 403
      ? 'token 无效 — 重新复制完整 URL(注意 token 别被截断)'
      : 'server 错误 ' + res.status);
    return;
  }
  clearErr();
  const d = await res.json();
  chkVer(d.ver);
  const rows = d.agents;
  rows.sort((a, b) => (b.ts || 0) - (a.ts || 0));  // most recently used first
  lastRows = rows;                          // the chat drawer reads the same
  diffAlerts(rows);
  const sig = JSON.stringify(rows);
  if (sig === lastRowsSig) return;        // nothing changed: keep the DOM
  lastRowsSig = sig;                       // (and the open previews with it)
  renderList();
  if (document.getElementById('drawer').classList.contains('on'))
    renderDrawer();                        // live-refresh while switching view
}
function renderList() {                    // home list: same grouping and
  const list = document.getElementById('list');   // filtering as the drawer
  list.innerHTML = '';
  document.getElementById('empty').hidden = lastRows.length > 0;
  const q = document.getElementById('lfilter').value.trim().toLowerCase();
  const rows = lastRows.filter(r => !q ||
      (r.title || r.window || '').toLowerCase().includes(q) ||
      (r.project || '').toLowerCase().includes(q) ||
      (r.agent || '').toLowerCase().includes(q));
  const groups = new Map();
  for (const r of rows) {
    const g = r.project || '—';
    (groups.get(g) || groups.set(g, []).get(g)).push(r);
  }
  if (!groups.size) {
    const e = document.createElement('div');
    e.className = 'dempty'; e.textContent = '无匹配';
    list.appendChild(e); return;
  }
  for (const [proj, grs] of groups) {
    const h = document.createElement('div');
    h.className = 'dgrp'; h.textContent = proj;
    list.appendChild(h);
    for (const r of grs) {
      const m = META[r.status] || { i:'❔', c:'#6c7086', n:2 };
      const row = document.createElement('div');
      row.className = 'row';
      row.innerHTML = `<span class="ico" style="color:${m.c}">${m.i}</span>` +
        `<div class="rmain"><span class="win">${esc(r.title || r.window)}</span>` +
        `<div class="rsub">${esc(r.agent)} · ${esc(r.project)}${r.age ? ' · ' + r.age : ''}</div></div>` +
        `<span class="btns"><span data-a="eye">👁</span><span data-a="tty">⌨</span></span>`;
      row.onclick = ev => {
        const a = ev.target.dataset && ev.target.dataset.a;
        if (a === 'tty') { openTerm(r.pane); return; }
        if (a === 'eye') { toggle(r.pane, row); return; }
        openChat(r.pane, r);            // tap the row itself → chat (orca-style)
      };
      list.appendChild(row);
      if (open[r.pane]) attachPreview(r.pane, row);
    }
  }
}
async function toggle(pane, row) {
  if (open[pane]) { open[pane].remove(); delete open[pane]; return; }
  await attachPreview(pane, row);
}
async function attachPreview(pane, row) {
  const pre = document.createElement('pre');
  row.after(pre); open[pane] = pre;
  try { pre.textContent = await (await fetch(`/api/preview/${pane}?token=${token}`)).text(); }
  catch { pre.textContent = '(preview failed)'; }
  return pre;
}

/* ---- chat view (orca-style: transcript bubbles + composer) ---- */
let chatPane = null, chatOffset = -1, chatTimer = null, chatPerm = null;
let chatPinned = true;                     // user at the transcript's bottom?
let chatHead = -1, chatDone = false;       // oldest loaded byte / exhausted
const fmtTok = n => n >= 1000 ? Math.round(n / 1000) + 'k' : '' + n;
const drafts = {};                     // per-pane half-typed prompts —
function saveDraft() {                 // switching agents must never carry
  if (chatPane)                        // text into the wrong chat
    drafts[chatPane] = document.getElementById('chat-in').value;
}
function openChat(pane, r) {
  saveDraft();
  chatPane = pane; chatOffset = -1;
  chatHead = -1; chatDone = false; lastUser = { t: '', pu: '' };
  const m = META[r.status] || { i:'❔', c:'#6c7086' };
  document.getElementById('chat-ico').textContent = m.i;
  document.getElementById('chat-ico').style.color = m.c;
  document.getElementById('chat-name').textContent = r.title || r.window;
  const sub = document.getElementById('chat-sub');
  sub.dataset.base = r.project + ' · ' + r.window;   // usage appends to this
  sub.textContent = sub.dataset.base;
  document.getElementById('ctx').textContent = '';
  document.getElementById('ctxd').hidden = true;
  document.getElementById('chat-in').value = drafts[pane] || '';
  document.getElementById('msgs').innerHTML = '';
  document.getElementById('chat').classList.add('on');
  fitInp();
  pollChat(true);
}
function closeChat() {
  saveDraft();
  chatPane = null;
  document.getElementById('chat').classList.remove('on');
  toggleDrawer(false);                    // never leave the drawer dangling
}
/* left drawer: agent switcher while a chat is open — tap ☰ to pull it
   out, tap a row to jump straight into that agent's transcript */
let lastRows = [];
function renderDrawer() {
  const box = document.getElementById('drows');
  box.innerHTML = '';
  const wait = lastRows.filter(r => r.status === 'waiting').length;
  document.getElementById('dwait').textContent = wait ? '⏳ ' + wait : '';
  const q = document.getElementById('dfilter').value.trim().toLowerCase();
  const rows = lastRows.filter(r => !q ||       // filter hits title, project
      (r.title || r.window || '').toLowerCase().includes(q) ||
      (r.project || '').toLowerCase().includes(q) ||
      (r.agent || '').toLowerCase().includes(q));
  const groups = new Map();                     // rows are ts-sorted, so
  for (const r of rows) {                       // first appearance fixes the
    const g = r.project || '—';                 // group order too
    (groups.get(g) || groups.set(g, []).get(g)).push(r);
  }
  if (!groups.size) {                           // a query that matches nothing
    const e = document.createElement('div');
    e.className = 'dempty'; e.textContent = '无匹配';
    box.appendChild(e); return;
  }
  for (const [proj, grs] of groups) {
    const h = document.createElement('div');
    h.className = 'dgrp'; h.textContent = proj;
    box.appendChild(h);
    for (const r of grs) {
      const m = META[r.status] || { i:'❔', c:'#6c7086' };
      const d = document.createElement('div');
      d.className = 'drow' + (r.pane === chatPane ? ' cur' : '');
      d.innerHTML = `<span class="ico" style="color:${m.c}">${m.i}</span>` +
        `<div class="dn"><div class="t">${esc(r.title || r.window)}</div>` +
        `<div class="s">${esc(r.agent)} · ${esc(r.project)}${r.age ? ' · ' + r.age : ''}</div></div>`;
      d.onclick = () => { toggleDrawer(false);
                          if (r.pane !== chatPane) openChat(r.pane, r); };
      box.appendChild(d);
    }
  }
}
function toggleDrawer(on) {
  const dr = document.getElementById('drawer');
  const show = on === undefined ? !dr.classList.contains('on') : on;
  dr.classList.toggle('on', show);
  document.getElementById('chat').classList.toggle('shift', show);
  document.getElementById('scrim').hidden = !show;   // phone overlay mode;
  if (show) renderDrawer();                          // wide CSS drops it and
  else document.getElementById('dfilter').value = ''; // pushes the chat —
}                                                    // fresh filter next open
// keyboard open/shrink: keep the transcript's end right above the composer.
// iOS also scrolls the page itself for the focused input — undo that.
if (window.visualViewport) visualViewport.addEventListener('resize', () => {
  setVh();
  window.scrollTo(0, 0);
  if (chatPinned) requestAnimationFrame(() => {
    const b = document.getElementById('msgs');
    if (b) b.scrollTop = b.scrollHeight;
  });
});
document.getElementById('msgs').addEventListener('scroll', ev => {
  const b = ev.target;
  chatPinned = b.scrollHeight - b.scrollTop - b.clientHeight < 60;
});
function ensureOlder() {                    // history pill, top of #msgs
  const box = document.getElementById('msgs');
  let b = document.getElementById('older');
  if (chatDone || chatHead <= 0) { if (b) b.remove(); return; }
  if (!b) {
    b = document.createElement('div'); b.id = 'older';
    b.textContent = '加载更早 ↑';
    box.insertBefore(b, box.firstChild);
  }
}
document.getElementById('msgs').addEventListener('click', async ev => {
  if (ev.target.id !== 'older' || chatHead <= 0) return;
  const b = ev.target;
  b.textContent = '加载中…';
  try {
    let d;                       // a page can be ONE unrenderable giant
    for (let hop = 0; hop < 4; hop++) {   // record — 0 msgs but head moved:
      const res = await fetch(`/api/chat/${chatPane}?token=${token}&before=${chatHead}`);
      if (!res.ok) throw 0;              // hop past it without a dead click
      d = await res.json();
      chatHead = d.head; chatDone = d.done;
      if (d.messages.length || d.done) break;
    }
    const box = document.getElementById('msgs');
    const oh = box.scrollHeight, ost = box.scrollTop;   // prepend without
    const frag = document.createDocumentFragment();     // jumping the view
    for (const m of d.messages) frag.appendChild(mkMsg(m));
    box.insertBefore(frag, b);            // older messages go above the pill
    b.remove(); ensureOlder();            // fresh pill if pages remain
    box.scrollTop = ost + (box.scrollHeight - oh);
  } catch { b.textContent = '加载失败,再试一次'; }
});
let chatBusy = false;                    // one poll in flight — overlapping
async function pollChat(force) {         // fetches double-append messages
  if (chatBusy || !chatPane || (!force && !document.getElementById('chat').classList.contains('on'))) return;
  chatBusy = true;
  try {
    let res;
    try { res = await fetch(`/api/chat/${chatPane}?token=${token}&after=${chatOffset}`); }
    catch { return; }
    if (!res.ok) return;
    const d = await res.json();
    chkVer(d.ver);
    chatOffset = d.offset;
    if (chatHead < 0 && d.head != null) chatHead = d.head;
    ensureOlder();
    const box = document.getElementById('msgs');
    const stick = box.scrollHeight - box.scrollTop - box.clientHeight < 60;
    chatPinned = stick;
    for (const m of d.messages) {
      if (m.role === 'user') {
        const pend = [...box.querySelectorAll('.m.pending')]
          .find(el => el.textContent === m.text);
        if (pend) { pend.classList.remove('pending'); continue; }  // adopted
      }
      if (m.role === 'compact')          // the card adopts the pending
        for (const el of                 // /compact chip; the chip itself
          box.querySelectorAll('.m.pending.cmd')) el.remove();   // is filtered
      addMsg(m);                         // server-side
    }
    if (stick) box.scrollTop = box.scrollHeight;
    chatStatus = d.status;
    const chip = document.getElementById('ctx');
    if (d.usage) {                       // TUI footer %, else absolute tokens
      if (d.usage.pct != null) chip.textContent = d.usage.pct + '%';
      else if (d.usage.ctx != null) chip.textContent = 'ctx ' + fmtTok(d.usage.ctx);
      chip.style.color = d.usage.pct >= 85 ? '#f38ba8'
                       : d.usage.pct >= 50 ? '#f9e2af' : '#a6e3a1';
      document.getElementById('modec').textContent =
        '⇄ ' + (d.usage.mode || '—');
      document.getElementById('ctxd').textContent =
        [d.usage.model, `ctx ${fmtTok(d.usage.ctx ?? 0)}`,
         `输出 ${fmtTok(d.usage.out ?? 0)}`].filter(Boolean).join(' · ');
    }
    chip.style.display = chip.textContent ? '' : 'none';  // an empty pill
    // in the cmds row would read as a dead button
    // typing indicator while the agent is working — with the TUI's live
    // working line (gerund · elapsed · ↓tokens) when we can read it.
    // /compact never flips @pane_status (no UserPromptSubmit fires for
    // it), so a live screen line must show even while the status is
    // idle; waiting keeps its own UI (perm bar), no typing bubble there
    let typing = document.getElementById('typing');
    if (d.status === 'running' || (d.live && d.status !== 'waiting')) {
      if (!typing) { typing = document.createElement('div'); typing.id = 'typing';
                     typing.className = 'm asst'; }
      const lab = d.live && d.live.label === 'compacting'
                ? '⌛ compact' : d.live && d.live.label;
      typing.textContent = lab ? `${lab} · ${d.live.meta}`
                               : `… 无新输出 ${d.age ?? '?'}s`;
      box.appendChild(typing);            // keep it at the end
    } else if (typing) { typing.remove(); }
    // live state: permission bar ONLY when a dialog is really on screen
    const perm = document.getElementById('perm');
    chatPerm = d.perm;                   // {allow:"1", always:"2", deny:"3"}
    perm.classList.toggle('on', !!(d.perm && d.perm.allow));
    document.getElementById('pname').textContent =   // the card says WHAT
      d.perm && d.perm.tool ? '⚙ ' + d.perm.tool : '';   // is asked, not
    document.getElementById('pwhat').textContent = d.perm && d.perm.what || '';
    document.getElementById('pname').style.display =
      d.perm && d.perm.tool ? '' : 'none';
    document.getElementById('pwhat').style.display =
      d.perm && d.perm.what ? '' : 'none';
    for (const b of perm.querySelectorAll('button'))   // y/n banners have
      b.style.display = d.perm && d.perm[b.dataset.a] ? '' : 'none';
    const m2 = META[d.status] || { i: '❔', c: '#6c7086' };
    const cmpct = d.live && d.live.label === 'compacting';
    document.getElementById('chat-ico').textContent = cmpct ? '⌛' : m2.i;
    document.getElementById('chat-ico').style.color = cmpct ? '#4a5378' : m2.c;
  } finally {
    chatBusy = false;
  }
}
function mkMsg(m) {              // build the bubble; caller appends/scrolls
  const div = document.createElement('div');
  div.className = 'm ' + (m.role === 'user' ? 'user' : m.role === 'tool' ? 'tool'
    : m.role === 'info' ? 'info' : m.role === 'think' ? 'think'
    : m.role === 'compact' ? 'compact' : 'asst');
  if (m.role === 'user' && m.text[0] === '/')   // slash command: a centered
    div.className = 'm cmd';                    // chip, not a right bubble
  if (m.role === 'tool') div.textContent = '⚙ ' + m.text;
  else if (m.role === 'user' || m.role === 'info') div.textContent = m.text;
  else if (m.role === 'compact') {   // the summary is a numbered template
    const d = document.createElement('details');   // (1. Primary Request … 9.
    const sm = document.createElement('summary');  // Optional Next Step) — fold
    sm.textContent = 'compact 摘要 · ' + m.text.length + ' 字';  // each section so
    const tx = document.createElement('div');      // the card is an outline,
    let folded = false;                            // not a 16k-char wall
    for (const p of m.text.split(/^(?=\d+\. )/m)) {
      const hm = p.match(/^(\d+)\. (.*)/);   // preamble before section 1 is
      if (!hm) continue;                     // template boilerplate — skip it
      const sd = document.createElement('details'); sd.className = 'sec';
      if (hm[1] === '1') sd.open = true;     // "what was this about" stays open
      const ss = document.createElement('summary');
      ss.textContent = hm[2].replace(/:$/, '');
      const bd = document.createElement('div'); bd.innerHTML = md(p.slice(hm[0].length));
      sd.appendChild(ss); sd.appendChild(bd); tx.appendChild(sd);
      folded = true;
    }
    if (!folded) tx.innerHTML = md(m.text);  // unexpected shape: flat markdown
    d.appendChild(sm); d.appendChild(tx); div.appendChild(d);
  }
  else if (m.role === 'think') {
    const d = document.createElement('details');
    const sm = document.createElement('summary'); sm.textContent = 'thinking…';
    const tx = document.createElement('div'); tx.textContent = m.text;
    d.appendChild(sm); d.appendChild(tx); div.appendChild(d);
  }
  else div.innerHTML = md(m.text);
  if (m.ts) {
    const d = new Date(m.ts);
    if (!isNaN(d)) {
      const t = document.createElement('span'); t.className = 'ts';
      t.textContent = String(d.getHours()).padStart(2,'0') + ':' +
                      String(d.getMinutes()).padStart(2,'0');
      div.appendChild(t);
    }
  }
  return div;
}
let lastUser = { t: '', pu: '' };  // mid-turn prompts are recorded twice
function addMsg(m) {               // with the SAME parentUuid — collapse
  if (m.role === 'user') {         // those, keep real repeats apart
    if (m.pu && m.pu === lastUser.pu && m.text === lastUser.t) return null;
    lastUser = { t: m.text, pu: m.pu || '' };
  }
  const box = document.getElementById('msgs');
  const div = mkMsg(m);
  box.appendChild(div);
  box.scrollTop = box.scrollHeight;
  return div;
}
async function sendChat() {
  const inp = document.getElementById('chat-in');
  const text = inp.value.trim();
  if (!text || !chatPane) return;
  inp.value = '';
  fitInp();
  delete drafts[chatPane];
  // optimistic echo: show the bubble NOW; the transcript poll adopts it
  // (and flips it solid) once Claude records the message
  const echo = addMsg({ role: 'user', ts: '', text });
  if (echo) echo.classList.add('pending');
  document.getElementById('chat-ico').textContent = '⚡';
  document.getElementById('chat-ico').style.color = META.running.c;
  try {
    await fetch(`/api/send/${chatPane}?token=${token}`,
      { method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ text }) });
    setTimeout(() => pollChat(true), 250);   // transcript write lands in
    setTimeout(() => pollChat(true), 900);   // ~100-300ms; catch it fast
  } catch { alert('发送失败'); }
}
// minimal markdown: code fences, inline code, bold, headers, bullets
function md(s) {
  s = esc(s).replace(/https?:\/\/[^\s<>"']+/g,
    u => '<a href="' + u + '" target="_blank" rel="noopener">' + u + '</a>');
  const parts = s.split(/```/);
  for (let i = 0; i < parts.length; i++)
    if (i % 2) parts[i] = '<pre><code>' + parts[i].replace(/^[a-zA-Z0-9_-]*\n/, '') + '</code></pre>';
    else {
      parts[i] = parts[i]
        .replace(/`([^`\n]+)`/g, '<code>$1</code>')
        .replace(/\*\*([^*\n]+)\*\*/g, '<b>$1</b>')
        .replace(/^#{1,4} (.*)$/gm, '<b>$1</b>')
        .replace(/^[-*] /gm, '• ');
    }
  return parts.join('').replace(/\n/g, '<br>');
}
// tap a code block to copy it
document.getElementById('msgs').addEventListener('click', ev => {
  const pre = ev.target.closest('pre');
  if (!pre || !navigator.clipboard) return;
  navigator.clipboard.writeText(pre.innerText).then(() => {
    pre.style.outline = '1px solid #a6e3a1';
    setTimeout(() => pre.style.outline = '', 400);
  });
});
document.getElementById('chat-close').onclick = closeChat;
document.getElementById('ctx').onclick = () => {    // tap for model + tokens
  const d = document.getElementById('ctxd');
  d.hidden = !d.hidden;
};
document.getElementById('chat-menu').onclick = () => toggleDrawer();
document.getElementById('dfilter').addEventListener('input', renderDrawer);
document.getElementById('lfilter').addEventListener('input', renderList);
document.addEventListener('click', ev => {  // phone only: a tap on the scrim
  const dr = document.getElementById('drawer');   // (the dimmed blank) closes.
  if (!dr.classList.contains('on')) return;       // Wide screens keep drawer
  if (dr.contains(ev.target)) return;             // and chat side by side —
  if (ev.target.closest && ev.target.closest('#chat-menu')) return;  // clicks
  if (matchMedia('(min-width:768px)').matches) return;  // in the chat must
  toggleDrawer(false);                            // NOT dismiss; ☰/Esc only
});
document.addEventListener('keydown', ev => {
  if (ev.key === 'Escape') toggleDrawer(false);
});
document.getElementById('cmds').onclick = ev => {   // one-tap slash commands
  const c = ev.target.dataset && ev.target.dataset.c;
  if (!c || !chatPane) return;
  document.getElementById('chat-in').value = c;
  sendChat();
};
document.getElementById('modec').onclick = async () => {  // shift+tab cycle
  if (!chatPane) return;
  try {
    await fetch(`/api/send/${chatPane}?token=${token}`,
      { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: 'BTab' }) });
    // staggered re-polls: the TUI redraws within ~100ms — first probe
    // that catches it updates the chip, no fixed-wait lag
    [150, 400, 900].forEach(ms => setTimeout(() => pollChat(true), ms));
  } catch { alert('切换失败'); }
};
document.getElementById('chat-send').onclick = sendChat;
document.getElementById('perm').onclick = async ev => {
  const a = ev.target.dataset && ev.target.dataset.a;
  if (!a || !chatPane || !chatPerm) return;
  const num = chatPerm[a];
  if (!num) return;
  try {
    await fetch(`/api/send/${chatPane}?token=${token}`,
      { method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ key: num }) });       // raw digit, no Enter
    // next poll re-verifies the bar from the screen
    setTimeout(() => pollChat(true), 800);
  } catch { alert('发送失败'); }
};
// soft keyboards have no Shift+Enter — there, Enter must insert a newline
// and sending happens via the button; on pointer devices Enter still sends
const coarse = matchMedia('(pointer: coarse)').matches;
document.getElementById('chat-in').addEventListener('keydown', ev => {
  if (!coarse && ev.key === 'Enter' && !ev.shiftKey) { ev.preventDefault(); sendChat(); }
});
// autosize: reset to auto first so deleting text shrinks the box back;
// programmatic value changes fire no input event, so call after those too
function fitInp() {
  const t = document.getElementById('chat-in');
  t.style.height = 'auto';
  t.style.height = Math.min(t.scrollHeight, 120) + 'px';
}
document.getElementById('chat-in').addEventListener('input', fitInp);
let chatStatus = '';
(function chatLoop() {                     // fast poll while the agent runs,
  setTimeout(() => {                       // relaxed when idle
    if (!term) pollChat(false);
    chatLoop();
  }, chatStatus === 'running' ? 700 : 2000);
})();

/* ---- live terminal: pane mirror ---- */
const KEYNAME = { esc:'Escape', enter:'Enter', tab:'Tab', up:'Up', down:'Down',
                  left:'Left', right:'Right', bs:'BSpace', int:'C-c' };
async function openTerm(pane) {
  document.getElementById('wbar').hidden = true;   // the term view owns the
  try { await loadXterm(); }                       // screen while it is open
  catch { alert('xterm.js 加载失败'); return; }
  if (!window.Terminal || !window.FitAddon) { alert('xterm.js 加载失败'); return; }
  closeTerm();
  document.getElementById('term').classList.add('on');
  term = new Terminal({ fontSize: 13, scrollback: 5000, cursorBlink: true,
                        theme: { background: '#0c0d14' } });
  fit = new FitAddon.FitAddon();
  term.loadAddon(fit);
  term.open(document.getElementById('xwrap'));
  fit.fit();                                   // phone drives the geometry
  term.onData(d => {
    if (ctrlArmed && d.length === 1) {
      const c = d.toLowerCase();
      if (c >= 'a' && c <= 'z') d = String.fromCharCode(c.charCodeAt(0) - 96);
      ctrlArmed = false; updateCtrl();
    }
    if (ws && ws.readyState === 1) ws.send(JSON.stringify({ text: d }));
  });
  const wsPort = parseInt(location.port) + 1;
  ws = new WebSocket(`ws://${location.hostname}:${wsPort}/api/term/${pane}?token=${token}`);
  ws.binaryType = 'arraybuffer';
  ws.onmessage = ev => {
    if (typeof ev.data === 'string') {
      let c; try { c = JSON.parse(ev.data); } catch { return; }
      if (c.error) { alert(c.error); closeTerm(); return; }
      if (c.ready) { sendDims(); return; }
      // server's effective geometry (fallback = pane-native) is authoritative
      if (c.cols && term && (term.cols !== c.cols || term.rows !== c.rows))
        term.resize(c.cols, c.rows);
      return;
    }
    if (term) term.write(new Uint8Array(ev.data));
  };
  term.focus();
}
function sendDims() {
  if (ws && ws.readyState === 1 && term)
    ws.send(JSON.stringify({ cols: term.cols, rows: term.rows }));
}
function refit() { if (term && fit) { fit.fit(); sendDims(); } }
let refitTimer = null;
const queueRefit = () => { clearTimeout(refitTimer); refitTimer = setTimeout(refit, 250); };
window.addEventListener('resize', queueRefit);
if (window.visualViewport) visualViewport.addEventListener('resize', queueRefit);
function closeTerm() {
  if (ws) { try { ws.close(); } catch {} ws = null; }
  if (term) { term.dispose(); term = null; }
  document.getElementById('term').classList.remove('on');
}
function updateCtrl() {
  document.querySelector('#keys button[data-k=ctrl]').classList.toggle('armed', ctrlArmed);
}
document.getElementById('keys').onclick = ev => {
  const k = ev.target.dataset && ev.target.dataset.k;
  if (!k) return;
  if (k === 'close') { closeTerm(); return; }
  if (k === 'kb') { if (term) term.focus(); return; }
  if (k === 'ctrl') { ctrlArmed = !ctrlArmed; updateCtrl(); return; }
  if (KEYNAME[k] && ws && ws.readyState === 1)
    ws.send(JSON.stringify({ key: KEYNAME[k] }));
  if (term) term.focus();
};
function esc(s) { const d = document.createElement('b'); d.textContent = s||''; return d.innerHTML; }
setInterval(tick, 2000);   // poll everywhere incl. term view — the version
// handshake rides on tick, and a page stuck in an overlay view must still
// be able to hot-reload after a deploy
document.addEventListener('visibilitychange', () => { if (!term) tick(); });
tick();
</script></body></html>"""
VER = hashlib.md5(PAGE.encode()).hexdigest()[:8]   # page build id
PAGE = PAGE.replace("__VER__", VER)                # handshake → hot reload


class Server(ThreadingHTTPServer):
    daemon_threads = True

    def handle_error(self, request, client_address):
        # phones RST their pooled keep-alive sockets on tab close /
        # network switch — routine, not worth a traceback in the journal
        exc = sys.exc_info()[1]
        if isinstance(exc, (ConnectionResetError, BrokenPipeError)):
            return
        super().handle_error(request, client_address)


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"     # keep-alive: one TCP conn for all assets

    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        data = body if isinstance(body, bytes) else body.encode()
        if len(data) > 1024 and "gzip" in self.headers.get("Accept-Encoding", ""):
            comp = gzip.compress(data, 6)
            if len(comp) < len(data):
                data = comp
                self.send_response(code)
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Encoding", "gzip")
                self.send_header("Cache-Control", "no-store")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        u = urlparse(self.path)
        if u.path in ASSETS:
            ctype, fname = ASSETS[u.path]
            try:
                with open(os.path.join(CONF_DIR, "assets", fname), "rb") as f:
                    data = f.read()
            except OSError:
                self._send(404, '{"error":"asset missing"}')
                return
            enc = ""
            if "gzip" in self.headers.get("Accept-Encoding", ""):
                comp = ASSET_GZ.get(u.path)
                if comp is None:            # compress once, not per request
                    comp = gzip.compress(data, 6)
                    ASSET_GZ[u.path] = comp
                data, enc = comp, "gzip"
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            if enc:
                self.send_header("Content-Encoding", enc)
            self.send_header("Cache-Control", "max-age=86400")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
            return
        if u.path == "/":
            self._send(200, PAGE, "text/html; charset=utf-8")
            return
        if bad_token(u.query):
            self._send(403, '{"error":"bad token"}')
            return
        if u.path == "/api/status":
            self._send(200, json.dumps({"ts": int(time.time()), "ver": VER,
                                        "agents": agent_rows()}))
        elif u.path.startswith("/api/chat/"):
            m = re.match(r"^/api/chat/(%\d+)$", u.path)
            pane = m.group(1) if m else ""
            try:   # one tmux call fetches sid + status + wait together
                st = subprocess.run(
                    [TMUX, "display-message", "-p", "-t", pane,
                     "#{@pane_session_id}|#{@pane_status}|#{@pane_wait_reason}"],
                    capture_output=True, text=True, errors="replace",
                    timeout=3,
                ).stdout.strip()
                sid, status, wait = (st.split("|") + ["", "", ""])[:3]
            except Exception:
                sid, status, wait = "", "", ""
            path = transcript_path(sid) if sid else None
            try:
                after = int(parse_qs(u.query).get("after", ["-1"])[0])
            except ValueError:
                after = -1
            if not path:
                # info notice only on the first fetch (after=-1); offset 0
                # keeps later polls from re-appending it every 2s
                self._send(200, json.dumps({
                    "offset": 0, "status": status, "wait": wait, "perm": None,
                    "messages": ([{"role": "info", "ts": "",
                                   "text": "无对话记录(codex/opencode 或会话未落盘),用 ⌨ 打开终端"}]
                                  if after == -1 else [])}))
                return
            qbefore = parse_qs(u.query).get("before", [""])[0]
            if qbefore.isdigit():            # one history page, oldest-first
                head, done, msgs = read_chat_before(path, int(qbefore))
                self._send(200, json.dumps({"head": head, "done": done,
                                            "messages": msgs}))
                return
            offset, head, msgs = read_chat(path, after)
            ctx, out, tmode = session_usage(path)
            screen = capture_tail(pane)          # one snapshot, two parsers
            model, pct = pane_ctx(screen)
            wlabel, wmeta = pane_live(screen)
            # live screen first; while the agent runs the TUI hint line is
            # covered, so fall back to the turn's structured permissionMode
            pmode = pane_mode(screen) or tmode
            if not wlabel:                  # working line unreadable (a full-
                pend = transcript_pending_tool(path)   # screen tool owns the
                if pend:                    # pane) — the transcript still
                    name, summ, ts = pend    # names the running tool
                    el = f"{int(time.time() - ts)}s" if ts else "?"
                    wlabel = name
                    wmeta = (summ[:40] + " · " + el) if summ else el
            try:                                 # transcript silence age —
                age = int(time.time() - os.path.getmtime(path))
            except OSError:
                age = None
            # permission bar, three-layer gate: pane waiting AND the
            # transcript ends on an unanswered tool_use AND the screen
            # really shows numbered options. Screen text alone false-
            # positives on already-answered dialogs still painted.
            if status != "waiting" or not transcript_pending_tool(path):
                perm = None
            else:
                perm = detect_perm(pane)
            perm = perm_gate(screen, status, path, pane) or perm
            if perm:                # attach WHAT is being approved — the
                pend = transcript_pending_tool(path)   # card shows content,
                if pend:            # not three mystery buttons
                    perm = dict(perm, tool=pend[0], what=pend[1])
            self._send(200, json.dumps({"offset": offset, "head": head,
                                        "messages": msgs,
                                        "status": status, "wait": wait,
                                        "perm": perm,
                                        "usage": {"ctx": ctx, "out": out,
                                                  "pct": pct, "model": model,
                                                  "mode": pmode},
                                        "live": ({"label": wlabel, "meta": wmeta}
                                                 if wlabel else None),
                                        "age": age, "ver": VER}))
        elif u.path.startswith("/api/preview/"):
            self._send(200, pane_preview(u.path[len("/api/preview/"):]),
                       "text/plain; charset=utf-8")
        else:
            self._send(404, '{"error":"not found"}')

    def do_POST(self):
        u = urlparse(self.path)
        if bad_token(u.query):
            self._send(403, '{"error":"bad token"}')
            return
        m = re.match(r"^/api/send/(%\d+)$", u.path)
        if not m or not pane_geometry(m.group(1)):
            self._send(404, '{"error":"pane gone"}')
            return
        n = int(self.headers.get("Content-Length", 0) or 0)
        if not 0 < n <= 65536:       # cap: a bogus Content-Length must not
            self._send(413, '{"error":"too large"}')   # hang a keep-alive
            self.close_connection = True               # thread on a read
            return
        try:
            body = json.loads(self.rfile.read(n))
            text = body.get("text")
        except Exception:
            body, text = {}, None
        if isinstance(text, str) and 0 < len(text) <= 4000:
            subprocess.run([TMUX, "send-keys", "-t", m.group(1), "-l", text],
                           capture_output=True, timeout=3)
            subprocess.run([TMUX, "send-keys", "-t", m.group(1), "Enter"],
                           capture_output=True, timeout=3)
            self._send(200, '{"ok":true}')
        else:
            # {"key": "1"} — a single raw keypress, no Enter (dialogs select
            # on the digit itself; appending Enter would leak into the input)
            key = body.get("key") if isinstance(body, dict) else None
            if isinstance(key, str) and (re.match(r"^[1-9a-zA-Z]$", key)
                                         or key in KEY_WHITELIST):
                subprocess.run([TMUX, "send-keys", "-t", m.group(1), key],
                               capture_output=True, timeout=3)
                self._send(200, '{"ok":true}')
            else:
                self._send(400, '{"error":"bad text"}')


def lan_ips():
    # pick real NICs + ZeroTier by interface NAME — range filters can't tell
    # libvirt (192.168.122.1) from a home LAN, and dropping 172.* kills
    # ZeroTier (172.23.x) along with docker (172.17.x).
    try:
        out = subprocess.run(["ip", "-brief", "addr"], capture_output=True,
                             text=True, timeout=2).stdout
    except Exception:
        out = ""
    keep = re.compile(r"^(en|eth|wl|zt)")
    ips = []
    for line in out.splitlines():
        f = line.split()
        if len(f) >= 3 and keep.match(f[0]):
            for a in f[2:]:
                if "." in a and not a.startswith(("127.", "169.254.")):
                    ips.append(a.split("/")[0])
    return ips or ["127.0.0.1"]


async def ws_main(bind, port):
    async with websockets.serve(term_handler, bind, port, max_size=None,
                                ping_interval=20, ping_timeout=20):
        await asyncio.Future()


def main():
    global TOKEN
    ap = argparse.ArgumentParser(description="mobile agent status + terminal")
    ap.add_argument("--port", type=int, default=7678)
    ap.add_argument("--bind", default="0.0.0.0")
    args = ap.parse_args()
    TOKEN = load_token()
    ensure_assets()
    for f in glob.glob("/tmp/agent-server-*.fifo"):   # SIGKILL leftovers
        try:
            os.unlink(f)
        except OSError:
            pass

    httpd = Server((args.bind, args.port), Handler)
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    print(f"agent-server http on {args.bind}:{args.port}, ws on {args.bind}:{args.port + 1}", flush=True)
    for ip in lan_ips():
        print(f"phone URL: http://{ip}:{args.port}/?token={TOKEN}", flush=True)
    asyncio.run(ws_main(args.bind, args.port + 1))


if __name__ == "__main__":
    main()
