#!/bin/bash
# tmux-swap-pane: 当前 pane 与本窗口内选中的 pane 互换位置
# prefix M-s → menu 列出同窗口其他 pane → swap; 源 = 触发时的当前 pane

SELF="$HOME/.local/sbin/tmux-swap-pane"

msg() { tmux display-message "tmux-swap-pane: $*"; }

if [ -n "${1:-}" ]; then
  # 参数是目标 %pane_id: 执行互换, 焦点跟到当前 pane 的新位置
  cur=$(tmux display -p '#{pane_id}')
  if err=$(tmux swap-pane -s "$cur" -t "$1" 2>&1); then
    tmux select-pane -t "$cur"
  else
    msg "互换失败: $err"
  fi
  exit 0
fi

cur=$(tmux display -p '#{pane_id}')
cur_idx=$(tmux display -p '#{pane_index}')
items=()
while IFS=$'\t' read -r pid pidx pcmd; do
  [ "$pid" = "$cur" ] && continue
  # 快捷键直接用 pane 编号(跳过当前 pane 的编号, 编号即键); >9 无单键, 略过
  [ "$pidx" -gt 9 ] && continue
  items+=("$pidx › $pcmd" "$pidx" "run-shell \"$SELF $pid\"")
done < <(tmux list-panes -F $'#{pane_id}\t#{pane_index}\t#{pane_current_command}')

if [ "${#items[@]}" -eq 0 ]; then
  msg "本窗口没有其他 pane"
  exit 0
fi
tmux display-menu -T " 互换 当前 pane($cur_idx) 与 ? " -x C -y C "${items[@]}" "取消" q ""
